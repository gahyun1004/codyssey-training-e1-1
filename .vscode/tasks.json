{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "E1-1: Verify Ubuntu Remote Workspace",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/ubuntu/verify-remote-workspace.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "E1-1: Verify WSL Ubuntu Workspace",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/ubuntu/verify-wsl-workspace.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "E1-1: Verify WSL Before Docker",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/ubuntu/verify-wsl-workspace.sh",
