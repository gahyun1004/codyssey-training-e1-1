      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "E1-1: Collect Docker Evidence",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/ubuntu/collect-docker-evidence.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "E1-1: Collect All Basic Evidence",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/ubuntu/collect-evidence.sh"
      ],
